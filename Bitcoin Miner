local lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/SugaBlaz/UI-Library/refs/heads/main/Atomiko%20UI.lua"))()

local player = game:GetService("Players").LocalPlayer
local RS = game:GetService("ReplicatedStorage")

local Events = RS:WaitForChild("Events")
local algofolders = player.PlayerGui:WaitForChild("NewUi").UiButtons.SubButtonsMenu.Algorithms.AlgStore

local states = {
	ACA = false,
	ASB = false,
	ASS = false,
	ASQ = false
}

local nums = {
	["1SHA-512"] = 1,
	["2Dagger"] = 2,
	["3Scrypt"] = 3,
	["4BloxChain"] = 4
}

local function getBestRate()
	local bestRate = 0
	local bestAlgNum = nil

	for _, v in pairs(algofolders:GetChildren()) do
		if v:IsA("TextLabel") then
			local cleanRate = string.gsub(v.Rate.Text, "x", "")
			local val = tonumber(cleanRate)

			if val and val > bestRate then
				bestRate = val
				bestAlgNum = nums[v.Name]
			end
		end
	end

	return bestRate, bestAlgNum
end

