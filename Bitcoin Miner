local lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/SugaBlaz/UI-Library/refs/heads/main/Atomiko%20UI.lua"))()

local player = game:GetService("Players").LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local Events = RS:WaitForChild("Events")

local states = {
    ACA = false,
    ASB = false,
    ASS = false,
    ASQ = false,
    WalkSpeed = 16
}

local nums = {
    ["1SHA-512"] = 1,
    ["2Dagger"] = 2,
    ["3Scrypt"] = 3,
    ["4BloxChain"] = 4
}

local function updateSpeed(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum.WalkSpeed = states.WalkSpeed
    end
end

player.CharacterAdded:Connect(updateSpeed)
if player.Character then updateSpeed(player.Character) end

local function getBestRate()
    local algofolders = player.PlayerGui:WaitForChild("NewUi").UiButtons.SubButtonsContainer.SubButtonsMenu.Algorithms.AlgStore
    local bestRate = 0
    local bestAlgNum = nil

    for _, v in pairs(algofolders:GetChildren()) do
        if v:IsA("TextLabel") and v:FindFirstChild("Rate") then
            local cleanRate = string.gsub(v.Rate.Text, "x", "")
            local val = tonumber(cleanRate)

            if val and val > bestRate then
                bestRate = val
                bestAlgNum = nums[v.Name]
            end
        end
    end
    return bestAlgNum
end

local win = lib:CreateWindow({
    Name = "Bitcoin Miner", 
    Position = UDim2.new(0.5, 0, 0.5, 0), 
    Size = UDim2.new(0, 250, 0, 250)
})

win:AddToggle({
    Text = "Auto Change Algorithm",
    Default = false,
    Callback = function(state)
        states["ACA"] = state
        if state then
            task.spawn(function()
                while states["ACA"] do
                    local num = getBestRate()
                    if num then
                        Events:WaitForChild("AlgoChange"):FireServer(tonumber(num))
                    end
                    task.wait(1)
                end
            end)
        end
    end
})

local function setupAutoSell(toggleText, stateKey, itemName)
    win:AddToggle({
        Text = toggleText,
        Default = false,
        Callback = function(state)
            states[stateKey] = state
            if state then
                task.spawn(function()
                    local exchangeRemote = Events:WaitForChild("Exchanger"):WaitForChild("Exchange")
                    while states[stateKey] do
                        exchangeRemote:InvokeServer(itemName, 1)
                        task.wait(1)
                    end
                end)
            end
        end
    end)
end

setupAutoSell("Auto Sell Bitcoin", "ASB", "Bitcoin")
setupAutoSell("Auto Sell Solaris", "ASS", "Solaris")
setupAutoSell("Auto Sell Quasar", "ASQ", "Quasar")

win:AddSlider({
    Text = "WalkSpeed",
    Default = 16,
    Min = 16,
    Max = 300,
    Callback = function(val)
        states.WalkSpeed = val
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = val
        end
    end
})

win:AddLabel({
    Text = "Developed By SugaDev"
})
